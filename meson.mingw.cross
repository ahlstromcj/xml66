#*****************************************************************************
# meson.mingw.cross (xml66)
#-----------------------------------------------------------------------------
##
# \file        meson.mingw.cross
# \library     xml66
# \author      Chris Ahlstrom
# \date        2026-05-19
# \updates     2026-05-23
# \license     $XPC_SUITE_GPL_LICENSE$
#
#  This file is part of the "xml66" library. See the top-level meson.build
#  file for license information.
#
#  Cross compiling with MinGW, Linux -> Windows
#
#     $ meson --cross-file meson.mingw.cross ...
#
#-----------------------------------------------------------------------------

[constants]

prefix = '/usr/x86_64-w64-mingw32/'
prepended = 'x86_64-w64-mingw32-'

[host_machine]

system = 'windows'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'

[properties]

cmake_toolchain_file = prefix + 'lib/cmake/libxml2/libxml2-config.cmake'
cmake_defaults = false

[binaries]

c = prepended + 'gcc'
cpp = prepended + 'g++'
ar = prepended + 'ar'
ld = prepended + 'ld'
objcopy = prepended + 'objcopy'
strip = prepended + 'strip'
windres = prepended + 'windres'
pkg-config = prepended + 'pkg-config'
exe_wrapper = 'wine64'

[cmake]

CMAKE_C_COMPILER = prepended + 'gcc'
CMAKE_CXX_COMPILER = prepended + 'g++'

#****************************************************************************
# meson.mingw.cross
#----------------------------------------------------------------------------
# vim: ts=3 sw=3 ft=dosini
#----------------------------------------------------------------------------
