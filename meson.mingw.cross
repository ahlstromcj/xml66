#*****************************************************************************
# meson.mingw.cross (xml66)
#-----------------------------------------------------------------------------
##
# \file        meson.mingw.cross
# \library     xml66
# \author      Chris Ahlstrom
# \date        2026-05-19
# \updates     2026-05-19
# \license     $XPC_SUITE_GPL_LICENSE$
#
#  This file is part of the "xml66" library. See the top-level meson.build
#  file for license information.
#
#  Cross compiling with MinGW, Linux -> Windows
#
#     $ meson --cross-file meson.mingw.cross ...
#
#-----------------------------------------------------------------------------

[constants]

prefix = 'x86_64-w64-mingw32-'

[host_machine]

system = 'windows'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'

[binaries]

c = prefix + 'gcc'
cpp = prefix + 'g++'
ar = prefix + 'ar'
strip = prefix + 'strip'
windres = prefix + 'windres'
exe_wrapper = 'wine64'

[cmake]

CMAKE_C_COMPILER = prefix + 'gcc'
CMAKE_CXX_COMPILER = prefix + 'g++'

#****************************************************************************
# meson.mingw.cross
